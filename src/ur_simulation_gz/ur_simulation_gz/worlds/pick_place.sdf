<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pick_place">
    <physics name="1ms" type="ignored">
      <!-- 500 Hz matches the ros2_control update period and avoids flooding
           RViz with a 1 kHz clock while the Gazebo GUI is rendering. -->
      <max_step_size>0.002</max_step_size>
      <real_time_factor>0.5</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.82 0.86 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.45 0.48 0.50 1</ambient>
            <diffuse>0.55 0.58 0.60 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table top: 1.20 x 0.90 m; working surface at z=0.75 m. -->
    <model name="work_table">
      <static>true</static>
      <pose>0.15 0 0 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision">
          <pose>0 0 0.71 0 0 0</pose>
          <geometry><box><size>1.20 0.90 0.08</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.71 0 0 0</pose>
          <geometry><box><size>1.20 0.90 0.08</size></box></geometry>
          <material>
            <ambient>0.34 0.22 0.12 1</ambient>
            <diffuse>0.55 0.36 0.19 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>

        <collision name="leg_front_left_collision">
          <pose>-0.50 -0.35 0.35 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.70</size></box></geometry>
        </collision>
        <visual name="leg_front_left_visual">
          <pose>-0.50 -0.35 0.35 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.70</size></box></geometry>
          <material><ambient>0.15 0.16 0.17 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material>
        </visual>

        <collision name="leg_front_right_collision">
          <pose>-0.50 0.35 0.35 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.70</size></box></geometry>
        </collision>
        <visual name="leg_front_right_visual">
          <pose>-0.50 0.35 0.35 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.70</size></box></geometry>
          <material><ambient>0.15 0.16 0.17 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material>
        </visual>

        <collision name="leg_back_left_collision">
          <pose>0.50 -0.35 0.35 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.70</size></box></geometry>
        </collision>
        <visual name="leg_back_left_visual">
          <pose>0.50 -0.35 0.35 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.70</size></box></geometry>
          <material><ambient>0.15 0.16 0.17 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material>
        </visual>

        <collision name="leg_back_right_collision">
          <pose>0.50 0.35 0.35 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.70</size></box></geometry>
        </collision>
        <visual name="leg_back_right_visual">
          <pose>0.50 0.35 0.35 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.70</size></box></geometry>
          <material><ambient>0.15 0.16 0.17 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Dynamic 50 mm cubes. Gazebo contact and friction provide the grasp;
         MoveIt mirrors the object only for planning-scene collision checks. -->
    <model name="red_cube">
      <static>false</static>
      <pose>-0.05 -0.16 0.775 0 0 0</pose>
      <link name="red_cube_link">
        <inertial><mass>0.10</mass><inertia><ixx>0.0000417</ixx><iyy>0.0000417</iyy><izz>0.0000417</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.8 0.02 0.02 1</ambient><diffuse>1 0.03 0.03 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="yellow_cube">
      <static>false</static>
      <pose>-0.05 0 0.775 0 0 0</pose>
      <link name="yellow_cube_link">
        <inertial><mass>0.10</mass><inertia><ixx>0.0000417</ixx><iyy>0.0000417</iyy><izz>0.0000417</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.8 0.65 0.01 1</ambient><diffuse>1 0.85 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_cube">
      <static>false</static>
      <pose>-0.05 0.16 0.775 0 0 0</pose>
      <link name="blue_cube_link">
        <inertial><mass>0.10</mass><inertia><ixx>0.0000417</ixx><iyy>0.0000417</iyy><izz>0.0000417</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.01 0.08 0.75 1</ambient><diffuse>0.02 0.15 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Visual-only target zones; no collision, so cubes rest directly on the table. -->
    <model name="zone_a">
      <static>true</static>
      <pose>0.09 -0.16 0.751 0 0 0</pose>
      <link name="zone_a_link">
        <visual name="zone_a_visual">
          <geometry><box><size>0.12 0.12 0.002</size></box></geometry>
          <material><ambient>0.05 0.75 0.18 0.55</ambient><diffuse>0.05 0.95 0.22 0.55</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="zone_b">
      <static>true</static>
      <pose>0.09 0 0.751 0 0 0</pose>
      <link name="zone_b_link">
        <visual name="zone_b_visual">
          <geometry><box><size>0.12 0.12 0.002</size></box></geometry>
          <material><ambient>0.95 0.35 0.02 0.55</ambient><diffuse>1 0.48 0.03 0.55</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="zone_c">
      <static>true</static>
      <pose>0.09 0.16 0.751 0 0 0</pose>
      <link name="zone_c_link">
        <visual name="zone_c_visual">
          <geometry><box><size>0.12 0.12 0.002</size></box></geometry>
          <material><ambient>0.55 0.05 0.80 0.55</ambient><diffuse>0.70 0.08 1 0.55</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
