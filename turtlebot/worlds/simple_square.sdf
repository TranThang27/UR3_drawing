<?xml version="1.0"?>
<!-- Local training world: 6 x 6 m free interior, three small obstacles.
     TurtleBot 4 and its dock spawn at the origin through official bringup. -->
<sdf version="1.8">
  <world name="simple_square">
    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <grid>false</grid>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.4 6.4 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 6.4 0.1</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="walls">
      <static>true</static>
      <link name="north">
        <pose>0 3.1 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.4 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
      <link name="south">
        <pose>0 -3.1 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.4 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
      <link name="east">
        <pose>3.1 0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 6 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
      <link name="west">
        <pose>-3.1 0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 6 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Different sizes and asymmetric positions help SLAM distinguish corners. -->
    <model name="small_box">
      <static>true</static><pose>-1.2 1.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.9 0.45 0.15 1</ambient><diffuse>0.9 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="long_box">
      <static>true</static><pose>1.2 1.4 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.4 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.4 0.6</size></box></geometry>
          <material><ambient>0.25 0.6 0.3 1</ambient><diffuse>0.25 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="round_pillar">
      <static>true</static><pose>1.0 -1.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.4 0.8 1</ambient><diffuse>0.3 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
