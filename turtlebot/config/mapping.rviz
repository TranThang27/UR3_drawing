Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Tool Properties
  Name: Tool Properties
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane: XY
  - Class: rviz_default_plugins/RobotModel
    Name: TurtleBot4
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/LaserScan
    Name: LiDAR
    Enabled: true
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
    Size (m): 0.03
    Style: Points
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: false
    Topic:
      Value: /odom
      Depth: 5
      Reliability Policy: Best Effort
    Keep: 10
    Position Tolerance: 0.1
    Angle Tolerance: 0.2
    Shape:
      Value: Arrow
      Alpha: 1
      Color: 255; 100; 0
      Shaft Length: 0.2
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.04
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Names: false
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 1.0
  - Class: rviz_default_plugins/Path
    Name: Global Plan
    Enabled: true
    Topic:
      Value: /plan
      Depth: 5
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: Survey Path
    Enabled: true
    Topic:
      Value: /survey_path
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color: 0; 210; 255
    Line Style: Lines
    Line Width: 0.04
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 65
      Angle: 0
      X: 0
      Y: 0
      Target Frame: map
Window Geometry:
  Width: 1200
  Height: 800
