Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.5
    Plane: XY
  - Class: rviz_default_plugins/RobotModel
    Name: TurtleBot4
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/LaserScan
    Name: LiDAR
    Enabled: true
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
    Size (m): 0.03
    Style: Points
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: false
    Topic:
      Value: /odom
      Depth: 5
      Reliability Policy: Best Effort
    Keep: 10
    Position Tolerance: 0.1
    Angle Tolerance: 0.2
    Shape:
      Value: Arrow
      Alpha: 1
      Color: 255; 100; 0
      Shaft Length: 0.2
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.04
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Names: false
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 1.0
  - Class: rviz_default_plugins/Path
    Name: Global Plan
    Enabled: true
    Topic:
      Value: /plan
      Depth: 5
      Reliability Policy: Reliable
    Color: 0; 220; 30
    Line Style: Lines
    Line Width: 0.04
  - Class: rviz_default_plugins/Map
    Name: Global Costmap
    Enabled: true
    Topic:
      Value: /global_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 0.45
    Color Scheme: costmap
    Draw Behind: false
  - Class: rviz_default_plugins/Map
    Name: Local Costmap
    Enabled: true
    Topic:
      Value: /local_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 0.35
    Color Scheme: costmap
    Draw Behind: false
  - Class: rviz_default_plugins/Path
    Name: Local Plan
    Enabled: true
    Topic:
      Value: /local_plan
    Color: 0; 200; 255
    Line Width: 0.025
  - Class: nav2_rviz_plugins/ParticleCloud
    Name: AMCL Particles
    Enabled: true
    Alpha: 1.0
    Color: 220; 30; 30
    Shape: Arrow (Flat)
    Min Arrow Length: 0.025
    Max Arrow Length: 0.12
    Topic:
      Value: /particle_cloud
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Path
    Name: Robot Travelled Path
    Enabled: true
    Color: 255; 145; 0
    Line Style: Lines
    Line Width: 0.04
    Topic:
      Value: /navigation_trail
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Polygon
    Name: Robot Footprint
    Enabled: true
    Color: 0; 255; 160
    Alpha: 1.0
    Topic:
      Value: /local_costmap/published_footprint
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 125
      Angle: 0
      X: 0
      Y: 0
      Target Frame: map
Window Geometry:
  Width: 1800
  Height: 1050
